{
  "$description": "Design tokens de Binōme (formato W3C DTCG). Fuente única de verdad: `npm run tokens` genera src/styles/tokens.css. Importable en Tokens Studio para Figma.",
  "color": {
    "$description": "Primitivas. Valores leídos de la captura de Figma del 15-nov-2026: VERIFICAR contra el archivo original (el coral difiere de la v2: #E8604C).",
    "cream": {
      "50":  { "$type": "color", "$value": "#FDF9F0" },
      "100": { "$type": "color", "$value": "#EFEBE2" },
      "200": { "$type": "color", "$value": "#E2DDD1" }
    },
    "ink": {
      "900": { "$type": "color", "$value": "#0A0A0A" },
      "800": { "$type": "color", "$value": "#1A1A1A" },
      "700": { "$type": "color", "$value": "#2B2B2B" },
      "500": { "$type": "color", "$value": "#5F5A52" },
      "300": { "$type": "color", "$value": "#B9B4AA" }
    },
    "coral": {
      "100": { "$type": "color", "$value": "#FBD9D3" },
      "300": { "$type": "color", "$value": "#F7A396" },
      "500": { "$type": "color", "$value": "#F26654" },
      "600": { "$type": "color", "$value": "#DB4A38" },
      "700": { "$type": "color", "$value": "#B83A2B" },
      "800": { "$type": "color", "$value": "#8C2C20" },
      "900": { "$type": "color", "$value": "#5C1D15" }
    },
    "yellow":   { "500": { "$type": "color", "$value": "#E6A700" } },
    "green":    { "500": { "$type": "color", "$value": "#71CEA8" } },
    "lavender": { "500": { "$type": "color", "$value": "#A49BF5" } }
  },
  "semantic": {
    "$description": "Roles. Cada sección declara data-tone=\"light|dark\" y redefine estos roles; los componentes solo usan roles, nunca primitivas.",
    "light": {
      "surface":        { "$type": "color", "$value": "{color.cream.50}" },
      "surface-alt":    { "$type": "color", "$value": "{color.cream.100}" },
      "text":           { "$type": "color", "$value": "{color.ink.900}" },
      "text-muted":     { "$type": "color", "$value": "{color.ink.500}" },
      "line":           { "$type": "color", "$value": "rgb(10 10 10 / 0.18)" },
      "accent":         { "$type": "color", "$value": "{color.coral.500}" },
      "accent-text":    { "$type": "color", "$value": "{color.coral.700}" },
      "accent-display": { "$type": "color", "$value": "{color.coral.600}" },
      "on-accent":      { "$type": "color", "$value": "{color.ink.900}" },
      "focus":          { "$type": "color", "$value": "{color.ink.900}" }
    },
    "dark": {
      "surface":        { "$type": "color", "$value": "{color.ink.900}" },
      "surface-alt":    { "$type": "color", "$value": "{color.ink.800}" },
      "text":           { "$type": "color", "$value": "{color.cream.50}" },
      "text-muted":     { "$type": "color", "$value": "{color.ink.300}" },
      "line":           { "$type": "color", "$value": "rgb(253 249 240 / 0.22)" },
      "accent":         { "$type": "color", "$value": "{color.coral.500}" },
      "accent-text":    { "$type": "color", "$value": "{color.coral.500}" },
      "accent-display": { "$type": "color", "$value": "{color.coral.500}" },
      "on-accent":      { "$type": "color", "$value": "{color.ink.900}" },
      "focus":          { "$type": "color", "$value": "{color.cream.50}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "'Funnel Display', 'Helvetica Neue', Arial, sans-serif" },
      "body":    { "$type": "fontFamily", "$value": "'DM Sans', 'Helvetica Neue', Arial, sans-serif" },
      "accent":  { "$type": "fontFamily", "$value": "'DM Serif Text', Georgia, 'Times New Roman', serif" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium":  { "$type": "fontWeight", "$value": "500" },
      "bold":    { "$type": "fontWeight", "$value": "700" }
    }
  },
  "step": {
    "$description": "Escala tipográfica fluida (360px → 1440px). Display máximo 6rem; tracking mínimo -0.04em.",
    "-1": { "$type": "dimension", "$value": "clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem)" },
    "0":  { "$type": "dimension", "$value": "clamp(1rem, 0.96rem + 0.18vw, 1.125rem)" },
    "1":  { "$type": "dimension", "$value": "clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem)" },
    "2":  { "$type": "dimension", "$value": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)" },
    "3":  { "$type": "dimension", "$value": "clamp(2rem, 1.6rem + 1.8vw, 3rem)" },
    "4":  { "$type": "dimension", "$value": "clamp(2.5rem, 1.9rem + 2.7vw, 4.25rem)" },
    "5":  { "$type": "dimension", "$value": "clamp(3rem, 2rem + 4.5vw, 6rem)" }
  },
  "leading": {
    "tight":  { "$type": "number", "$value": "1.04" },
    "snug":   { "$type": "number", "$value": "1.18" },
    "normal": { "$type": "number", "$value": "1.6" }
  },
  "tracking": {
    "display": { "$type": "dimension", "$value": "-0.035em" },
    "heading": { "$type": "dimension", "$value": "-0.02em" },
    "label":   { "$type": "dimension", "$value": "0.06em" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "section": { "$type": "dimension", "$value": "clamp(5rem, 3rem + 8vw, 11rem)" },
    "gutter":  { "$type": "dimension", "$value": "clamp(1.25rem, 0.5rem + 3vw, 3rem)" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.75rem" },
    "card": { "$type": "dimension", "$value": "1.5rem" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "layout": {
    "container": { "$type": "dimension", "$value": "90rem" },
    "measure":   { "$type": "dimension", "$value": "68ch" },
    "target":    { "$type": "dimension", "$value": "2.75rem" }
  },
  "shadow": {
    "lift": { "$type": "shadow", "$value": "0 1px 2px rgb(10 10 10 / 0.06), 0 12px 32px -8px rgb(10 10 10 / 0.18)" }
  },
  "motion": {
    "ease-out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "fast":     { "$type": "duration", "$value": "180ms" },
    "base":     { "$type": "duration", "$value": "420ms" },
    "slow":     { "$type": "duration", "$value": "900ms" }
  }
}
