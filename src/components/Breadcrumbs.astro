---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
interface Props { items: { name: string; href?: string }[]; locale?: Locale }
const { items, locale = 'es' } = Astro.props;
---
<nav class="migas" aria-label={t(locale, 'migas')}>
  <ol>
    {items.map((it, i) => (
      <li>{it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
