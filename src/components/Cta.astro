---
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { href, type Locale } from '../i18n/config';
interface Props { locale?: Locale; tone?: 'light' | 'dark' }
const { locale = 'es', tone = 'light' } = Astro.props;
---
<section class="cta seccion" data-tone={tone} aria-labelledby="cta-titulo">
  <div class="contenedor cta__cuerpo">
    <h2 id="cta-titulo" class="cta__titulo" set:html={t(locale, 'ctaTitulo')} />
    <p class="cta__texto">{t(locale, 'ctaTexto')}</p>
    <a class="boton boton--coral" href={href('/contacto/', locale)}>{t(locale, 'contactanos')}</a>
    <a class="cta__email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</section>
