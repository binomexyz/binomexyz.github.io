---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import Persona from '../components/Persona.astro';
import ProyectoCard from '../components/ProyectoCard.astro';
import ProyectoCover from '../components/ProyectoCover.astro';
import { servicios } from '../data/servicios';
import { site } from '../data/site';
import { getCopy } from '../i18n/copy';
import { getProyectos } from '../lib/proyectos';
import { faqPage } from '../lib/schema';
import { equivalentes, link, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getCopy(locale);
const h = c.home;
const proyectos = await getProyectos(locale);
const destacados = proyectos.filter((p) => p.data.destacado);
---

<Base
  locale={locale}
  title={h.title}
  description={h.description}
  tone="light"
  current="inicio"
  alternates={equivalentes('inicio')}
  jsonLd={[faqPage(h.faqs)]}
>
  <section class="hero" data-tone="light" aria-labelledby="hero-titulo">
    <div class="hero__escena" data-escena aria-hidden="true">
      <svg class="hero__escena-fallback" viewBox="-1.6 -1 3.2 2" preserveAspectRatio="xMidYMid meet" focusable="false" aria-hidden="true">
        <path d="M0.558 0.350A0.62 0.62 0 0 0 0.013 -0.540" fill="none" stroke="var(--color-coral-500)" stroke-width="0.30" stroke-linecap="round" />
        <path d="M-0.558 -0.190A0.62 0.62 0 0 0 -0.013 0.700" fill="none" stroke="var(--color-lavender-500)" stroke-width="0.30" stroke-linecap="round" />
        <rect x="-0.205" y="-0.905" width="0.41" height="0.08" rx="0.04" fill="var(--color-ink-900)" />
      </svg>
    </div>
    <div class="contenedor hero__cuerpo">
      <h1 id="hero-titulo" class="hero__titulo entra-t" set:html={h.h1} />
      <p class="hero__lead entra entra--2">{h.lead}</p>
      <div class="hero__acciones entra entra--3">
        <a class="boton boton--coral" href={link('contacto', locale)}>{t(locale, 'empiezaProyecto')}</a>
        <a class="boton boton--contorno" href={link('proyectos', locale)}>{t(locale, 'verProyectos')}</a>
      </div>
    </div>
    <div class="contenedor"><div class="hero__linea" aria-hidden="true"><span>{h.estudio}</span><hr /><span>{site.city}</span></div></div>
    <ul class="hero__pista" aria-label={h.destacados}>
      {destacados.map((p, i) => (
        <li>
          <a class="caso" href={link('proyecto', locale, p.slug)} data-cursor={t(locale, 'verCaso')}>
            <ProyectoCover locale={locale} slug={p.slug} nombre={p.data.nombre} tono={p.data.tono} sizes="(min-width: 600px) 400px, 76vw" eager={i < 2} />
            <div class="caso__texto"><h2 class="caso__nombre" style="font-size:var(--step-1)">{p.data.nombre}</h2><p class="caso__cat">{p.data.categorias[0]}</p></div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="seccion enunciado" data-tone="dark" aria-labelledby="enunciado">
    <div class="contenedor">
      <h2 id="enunciado" class="enunciado__texto" data-enunciado>{h.enunciado}</h2>
      <p class="enunciado__apoyo" data-reveal>{h.enunciadoApoyo}</p>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="servicios-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="servicios-titulo" data-reveal>{h.serviciosTitulo}</h2>
        <a class="boton boton--contorno" href={link('servicios', locale)} data-reveal>{h.nuestrosServicios} <Icono nombre="flecha" /></a>
      </div>
      <ul class="servicios__lista">
        {servicios.map((s) => {
          const it = c.servicios.items[s.slug];
          return (
            <li class={`servicio tono-${s.tono}`} data-reveal>
              <h3 class="servicio__nombre"><a href={link('servicio', locale, s.slug)}>{it.nombre}</a></h3>
              <div>
                <p class="servicio__texto">{it.resumen}</p>
                <ul class="servicio__etiquetas">{it.incluye.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
              </div>
              <span class="servicio__ir" aria-hidden="true"><Icono nombre="flecha" tamano={22} /></span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--alt" data-tone="light" aria-labelledby="casos-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="casos-titulo" data-reveal>{h.casosTitulo}</h2>
        <a class="boton boton--contorno" href={link('proyectos', locale)} data-reveal>{h.todosProyectos} <Icono nombre="flecha" /></a>
      </div>
      <div class="casos">
        {destacados.map((p) => <ProyectoCard locale={locale} slug={p.slug} nombre={p.data.nombre} categorias={p.data.categorias} tono={p.data.tono} />)}
      </div>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="nosotros-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="nosotros-titulo" data-reveal>{h.nosotrosTitulo}</h2>
        <p data-reveal>{h.nosotrosTexto}</p>
      </div>
      <div class="equipo">
        {site.founders.map((f) => <Persona locale={locale} id={f.id} nombre={f.name} alias={f.alias} rol={c.fundadores[f.id].role} bio={c.fundadores[f.id].bio} />)}
      </div>
      <p style="margin-top:2.5rem"><a class="boton boton--contorno" href={link('nosotros', locale)}>{h.conocenos} <Icono nombre="flecha" /></a></p>
    </div>
  </section>

  <section class="seccion" data-tone="dark" aria-labelledby="proceso-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="proceso-titulo" data-reveal>{h.procesoTitulo}</h2>
      </div>
      <ol class="proceso">
        {h.proceso.map((p) => <li data-reveal><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="porque-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="porque-titulo" data-reveal>{h.porqueTitulo}</h2>
      </div>
      <ul class="porque">
        {h.porQueNosotros.map((p) => <li data-reveal><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--alt" data-tone="light" aria-labelledby="faq-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion"><h2 id="faq-titulo" data-reveal>{h.faqTitulo}</h2></div>
      <div class="faq">
        {h.faqs.map((f) => (
          <details>
            <summary>{f.q}<Icono nombre="mas" tamano={24} /></summary>
            <p class="faq__respuesta">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta locale={locale} tone="light" />
</Base>
<script>
  import '../scripts/hero-escena';
</script>
