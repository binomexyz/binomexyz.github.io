---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import ProyectoCard from '../components/ProyectoCard.astro';
import Cta from '../components/Cta.astro';
import { getProyectos } from '../lib/proyectos';
import { getCopy } from '../i18n/copy';
import { equivalentes, link, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { breadcrumbs } from '../lib/schema';
interface Props { locale: Locale }
const { locale } = Astro.props;
const p = getCopy(locale).proyectos;
const proyectos = await getProyectos(locale);
const origin = Astro.site!.toString().replace(/\/$/, '');
const abs = (path: string) => `${origin}${path}`;
const lista = {
  '@type': 'ItemList',
  itemListElement: proyectos.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(link('proyecto', locale, x.slug)), name: x.data.nombre })),
};
---
<Base
  locale={locale}
  title={p.title}
  description={p.description}
  current="proyectos"
  alternates={equivalentes('proyectos')}
  jsonLd={[lista, breadcrumbs([{ name: t(locale, 'inicio'), url: abs(link('inicio', locale)) }, { name: p.migas, url: abs(link('proyectos', locale)) }])]}
>
  <CabeceraPagina locale={locale} titulo={p.h1} migas={[{ name: t(locale, 'inicio'), href: link('inicio', locale) }, { name: p.migas }]} />
  <section class="seccion--compacta" data-tone="light" aria-label={p.aria}>
    <div class="contenedor">
      <div class="casos">
        {proyectos.map((x, i) => <ProyectoCard locale={locale} slug={x.slug} nombre={x.data.nombre} categorias={x.data.categorias} tono={x.data.tono} eager={i < 2} nivel="h2" />)}
      </div>
    </div>
  </section>
  <Cta locale={locale} tone="light" />
</Base>
