---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import { servicios } from '../data/servicios';
import { getCopy } from '../i18n/copy';
import { equivalentes, link, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { breadcrumbs, service } from '../lib/schema';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getCopy(locale);
const s = c.servicios;
const origin = Astro.site!.toString().replace(/\/$/, '');
const url = (key: Parameters<typeof link>[0]) => `${origin}${link(key, locale)}`;
---
<Base
  locale={locale}
  title={s.title}
  description={s.description}
  current="servicios"
  alternates={equivalentes('servicios')}
  jsonLd={[breadcrumbs([{ name: t(locale, 'inicio'), url: url('inicio') }, { name: s.migas, url: url('servicios') }]), ...servicios.map((x) => service(origin, x, locale))]}
>
  <CabeceraPagina locale={locale} titulo={s.h1} lead={s.lead} migas={[{ name: t(locale, 'inicio'), href: link('inicio', locale) }, { name: s.migas }]} />
  <section class="seccion--compacta" data-tone="light" aria-label={s.aria}>
    <div class="contenedor">
      <ul class="servicios__lista">
        {servicios.map((x) => {
          const it = s.items[x.slug];
          return (
            <li class={`servicio tono-${x.tono}`}>
              <h2 class="servicio__nombre" style="font-size:var(--step-4)"><a href={link('servicio', locale, x.slug)}>{it.nombre}</a></h2>
              <div>
                {it.descripcion.map((d) => <p class="servicio__texto">{d}</p>)}
                <ul class="servicio__etiquetas">{it.incluye.map((i) => <li>{i}</li>)}</ul>
              </div>
              <span class="servicio__ir" aria-hidden="true"><Icono nombre="flecha" tamano={22} /></span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  <Cta locale={locale} tone="light" />
</Base>
