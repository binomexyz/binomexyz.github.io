---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Cta from '../../components/Cta.astro';
import Icono from '../../components/Icono.astro';
import { servicios } from '../../data/servicios';
import { href } from '../../i18n/config';
import { breadcrumbs, service } from '../../lib/schema';
const origin = Astro.site!.toString().replace(/\/$/, '');
---
<Base
  title="Servicios | Diseño web, branding y estrategia de marca — Binōme"
  description="Branding, páginas web, producto digital y estrategia digital para empresas que quieren destacar online. Estudio boutique en Madrid."
  current="servicios"
  jsonLd={[breadcrumbs([{ name: 'Inicio', url: `${origin}/` }, { name: 'Servicios', url: `${origin}/servicios/` }]), ...servicios.map((s) => service(origin, s))]}
>
  <CabeceraPagina titulo={'Te ayudamos a <em class="acento">crecer.</em>'} lead="Cuatro servicios que se apoyan entre sí: una marca clara, una web que convierte, un producto que se entiende y una presencia que se sostiene." migas={[{ name: 'Inicio', href: href('/') }, { name: 'Servicios' }]} />
  <section class="seccion--compacta" data-tone="light" aria-label="Servicios">
    <div class="contenedor">
      <ul class="servicios__lista">
        {servicios.map((s) => (
          <li class={`servicio tono-${s.tono}`}>
            <h2 class="servicio__nombre" style="font-size:var(--step-4)"><a href={href(`/servicios/${s.slug}/`)}>{s.nombre}</a></h2>
            <div>
              {s.descripcion.map((d) => <p class="servicio__texto">{d}</p>)}
              <ul class="servicio__etiquetas">{s.incluye.map((i) => <li>{i}</li>)}</ul>
            </div>
            <span class="servicio__ir" aria-hidden="true"><Icono nombre="flecha" tamano={22} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Cta tone="light" />
</Base>
