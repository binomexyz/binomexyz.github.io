---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Notas from '../../components/Notas.astro';
import { categoriaPorSlug } from '../../data/categorias';
import { site } from '../../data/site';
import { getArticulos } from '../../lib/proyectos';
import { href } from '../../i18n/config';
import { blogPosting, breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const todos = await getArticulos('es');
  return todos.map((a) => ({ params: { slug: a.slug }, props: { a, todos } }));
}
const { a, todos } = Astro.props;
const d = a.data;
const { Content } = await render(a);
const c = categoriaPorSlug(d.categoria)!;
const autor = site.founders.find((f) => f.id === d.autor)!;
const origin = Astro.site!.toString().replace(/\/$/, '');
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const relacionados = todos.filter((x) => x.slug !== a.slug && x.data.categoria === d.categoria).slice(0, 3);
---
<Base
  title={`${d.titulo} | Binōme`}
  description={d.descripcion}
  current="archivo"
  type="article"
  articlePublished={d.fecha}
  jsonLd={[
    blogPosting(origin, { slug: a.slug, titulo: d.titulo, descripcion: d.descripcion, fecha: d.fecha, actualizado: d.actualizado, autor: d.autor, image: `${origin}/og-default.png` }),
    breadcrumbs([{ name: 'Inicio', url: `${origin}/` }, { name: 'Archivo', url: `${origin}/archivo/` }, { name: d.titulo, url: `${origin}/archivo/${a.slug}/` }]),
  ]}
>
  <article>
    <header class="seccion seccion--arriba" data-tone="light">
      <div class="contenedor articulo__cabecera" style="margin-inline:auto">
        <Breadcrumbs items={[{ name: 'Inicio', href: href('/') }, { name: 'Archivo', href: href('/archivo/') }, { name: c.nombre, href: href(`/archivo/categoria/${c.slug}/`) }]} />
        <h1 class="articulo__titulo entra-t">{d.titulo}</h1>
        <p class="ficha__resumen entra entra--2">{d.descripcion}</p>
        <p class="articulo__meta" style="margin-top:1.5rem">
          <span>Por {autor.name}</span>
          <time datetime={d.fecha.toISOString().slice(0, 10)}>{fmt.format(d.fecha)}</time>
          {d.actualizado && <span>Actualizado el <time datetime={d.actualizado.toISOString().slice(0, 10)}>{fmt.format(d.actualizado)}</time></span>}
        </p>
      </div>
    </header>
    <div class="contenedor articulo__cuerpo" data-tone="light" style="padding-bottom:var(--space-section)">
      <div class="texto" style="margin-inline:auto"><Content /></div>
    </div>
  </article>
  {relacionados.length > 0 && (
    <section class="seccion seccion--alt" data-tone="light" aria-labelledby="rel-titulo">
      <div class="contenedor"><div class="cabecera-seccion"><h2 id="rel-titulo" style="font-size:var(--step-3)">Sigue leyendo</h2></div><Notas articulos={relacionados} nivel="h3" /></div>
    </section>
  )}
  <Cta tone="light" />
</Base>
