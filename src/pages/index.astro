---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import Persona from '../components/Persona.astro';
import ProyectoCard from '../components/ProyectoCard.astro';
import ProyectoCover from '../components/ProyectoCover.astro';
import { servicios } from '../data/servicios';
import { site } from '../data/site';
import { porQueNosotros, proceso, faqs } from '../data/home';
import { getProyectos } from '../lib/proyectos';
import { faqPage } from '../lib/schema';
import { href } from '../i18n/config';
import { t } from '../i18n/ui';

const proyectos = await getProyectos('es');
const destacados = proyectos.filter((p) => p.data.destacado);
---

<Base
  title="Binōme | Estudio de branding y diseño web en Madrid"
  description="Estudio digital boutique en Madrid: branding, páginas web y producto digital para empresas que quieren ganar autoridad online."
  tone="light"
  current="inicio"
  jsonLd={[faqPage(faqs)]}
>
  <section class="hero" data-tone="light" aria-labelledby="hero-titulo">
    <div class="contenedor hero__cuerpo">
      <h1 id="hero-titulo" class="hero__titulo entra-t">Tu marca al nivel que tu negocio <em class="acento">merece.</em></h1>
      <p class="hero__lead entra entra--2">Branding, webs y producto digital para empresas que quieren transmitir online la misma calidad que en persona.</p>
      <div class="hero__acciones entra entra--3">
        <a class="boton boton--coral" href={href('/contacto/')}>{t('es', 'empiezaProyecto')}</a>
        <a class="boton boton--contorno" href={href('/proyectos/')}>{t('es', 'verProyectos')}</a>
      </div>
    </div>
    <div class="contenedor"><div class="hero__linea" aria-hidden="true"><span>Estudio digital</span><hr /><span>{site.city}</span></div></div>
    <ul class="hero__pista" aria-label="Proyectos destacados">
      {destacados.map((p, i) => (
        <li>
          <a class="caso" href={href(`/proyecto/${p.slug}/`)} data-cursor={t('es', 'verCaso')}>
            <ProyectoCover slug={p.slug} nombre={p.data.nombre} tono={p.data.tono} sizes="(min-width: 600px) 400px, 76vw" eager={i < 2} />
            <div class="caso__texto"><h2 class="caso__nombre" style="font-size:var(--step-1)">{p.data.nombre}</h2><p class="caso__cat">{p.data.categorias[0]}</p></div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="seccion enunciado" data-tone="dark" aria-labelledby="enunciado">
    <div class="contenedor">
      <h2 id="enunciado" class="enunciado__texto" data-enunciado>Cada punto de contacto con tu cliente es una oportunidad.</h2>
      <p class="enunciado__apoyo" data-reveal>En binōme, hacemos que donde quiera que te encuentren, sepan que eres tú.</p>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="servicios-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="servicios-titulo" data-reveal>Lo que hacemos por ti</h2>
        <a class="boton boton--contorno" href={href('/servicios/')} data-reveal>Nuestros servicios <Icono nombre="flecha" /></a>
      </div>
      <ul class="servicios__lista">
        {servicios.map((s) => (
          <li class={`servicio tono-${s.tono}`} data-reveal>
            <h3 class="servicio__nombre"><a href={href(`/servicios/${s.slug}/`)}>{s.nombre}</a></h3>
            <div>
              <p class="servicio__texto">{s.resumen}</p>
              <ul class="servicio__etiquetas">{s.incluye.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
            </div>
            <span class="servicio__ir" aria-hidden="true"><Icono nombre="flecha" tamano={22} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--alt" data-tone="light" aria-labelledby="casos-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="casos-titulo" data-reveal>Casos recientes</h2>
        <a class="boton boton--contorno" href={href('/proyectos/')} data-reveal>Todos los proyectos <Icono nombre="flecha" /></a>
      </div>
      <div class="casos">
        {destacados.map((p) => <ProyectoCard slug={p.slug} nombre={p.data.nombre} categorias={p.data.categorias} tono={p.data.tono} />)}
      </div>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="nosotros-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="nosotros-titulo" data-reveal>Dos diseñadores. Un solo criterio.</h2>
        <p data-reveal>Pensamos, diseñamos y construimos contigo cada parte de tu presencia digital.</p>
      </div>
      <div class="equipo">
        {site.founders.map((f) => <Persona id={f.id} nombre={f.name} alias={f.alias} rol={f.role} bio={f.bio} />)}
      </div>
      <p style="margin-top:2.5rem"><a class="boton boton--contorno" href={href('/nosotros/')}>Conócenos <Icono nombre="flecha" /></a></p>
    </div>
  </section>

  <section class="seccion" data-tone="dark" aria-labelledby="proceso-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="proceso-titulo" data-reveal>Así trabajamos contigo</h2>
      </div>
      <ol class="proceso">
        {proceso.map((p) => <li data-reveal><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion" data-tone="light" aria-labelledby="porque-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="porque-titulo" data-reveal>Lo que nos hace diferentes</h2>
      </div>
      <ul class="porque">
        {porQueNosotros.map((p) => <li data-reveal><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--alt" data-tone="light" aria-labelledby="faq-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion"><h2 id="faq-titulo" data-reveal>Preguntas frecuentes</h2></div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<Icono nombre="mas" tamano={24} /></summary>
            <p class="faq__respuesta">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta tone="light" />
</Base>
