---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import { site } from '../data/site';
import { href } from '../i18n/config';
import { t } from '../i18n/ui';
import { breadcrumbs } from '../lib/schema';
const origin = Astro.site!.toString().replace(/\/$/, '');
const formId = import.meta.env.PUBLIC_FORMSPREE_ID;
const action = formId ? `https://formspree.io/f/${formId}` : `mailto:${site.email}`;
const reunion = import.meta.env.PUBLIC_BOOKING_URL || `mailto:${site.email}?subject=${encodeURIComponent('Agendar una reunión — Binōme')}`;
---
<Base
  title="Contacto | Cuéntanos tu proyecto — Binōme"
  description="¿Necesitas rediseñar tu marca o tu web? Escríbenos o agenda una reunión: te respondemos en menos de 24 horas. Estudio en Madrid."
  tone="dark"
  current="contacto"
  jsonLd={[
    { '@type': 'ContactPage', '@id': `${origin}/contacto/#page`, url: `${origin}/contacto/`, name: 'Contacto — Binōme', about: { '@id': `${origin}/#organization` } },
    breadcrumbs([{ name: 'Inicio', url: `${origin}/` }, { name: 'Contacto', url: `${origin}/contacto/` }]),
  ]}
>
  <CabeceraPagina tone="dark" titulo="Contacto" lead="Ya sea que quieras hablar sobre un nuevo proyecto o simplemente conocernos un poco más, nos encantaría saber de ti. Respondemos en menos de 24 horas." migas={[{ name: 'Inicio', href: href('/') }, { name: 'Contacto' }]} />
  <section class="seccion--compacta seccion" data-tone="dark" aria-label="Formas de contacto">
    <div class="contenedor">
      <div class="filas">
        <div class="fila"><p class="fila__etiqueta">Escríbenos</p><p class="fila__valor"><a href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <> <span aria-hidden="true">/</span> <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></>}</p></div>
        <div class="fila"><p class="fila__etiqueta">Redes</p><p class="fila__valor"><a href={site.social.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only"> (se abre en una pestaña nueva)</span></a> <span aria-hidden="true">/</span> <a href={site.social.instagram} rel="me noopener" target="_blank">Instagram<span class="sr-only"> (se abre en una pestaña nueva)</span></a></p></div>
        <div class="fila"><p class="fila__etiqueta">Reúnete con nosotros</p><p class="fila__valor"><a href={reunion} {...(reunion.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>Agenda una reunión</a></p></div>
      </div>
    </div>
  </section>
  <section class="seccion" data-tone="dark" aria-labelledby="form-titulo">
    <div class="contenedor">
      <h2 id="form-titulo" style="font-size:var(--step-3);margin-bottom:2rem">Deja un mensaje</h2>
      <form class="formulario" method="post" action={action} data-formulario novalidate
        data-enviando={t('es', 'enviando')} data-ok={t('es', 'gracias')} data-error={t('es', 'errorEnvio')}>
        <input type="hidden" name="_subject" value="Nuevo mensaje desde binome.xyz" />
        <div class="trampa" aria-hidden="true"><label>No rellenar<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
        <div class="campo">
          <label class="campo__etiqueta" for="f-nombre">Nombre</label>
          <input id="f-nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="f-nombre-error" data-error-vacio="Dinos cómo te llamas." />
          <p class="campo__error" id="f-nombre-error"></p>
        </div>
        <div class="campo">
          <label class="campo__etiqueta" for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-ayuda f-email-error" data-error-vacio="Necesitamos tu email para responderte." data-error-formato="Revisa el email: parece que falta algo (nombre@empresa.com)." />
          <p class="campo__ayuda" id="f-email-ayuda">Te contestamos aquí.</p>
          <p class="campo__error" id="f-email-error"></p>
        </div>
        <div class="campo">
          <label class="campo__etiqueta" for="f-telefono">Teléfono <span class="campo__ayuda">(opcional)</span></label>
          <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="f-telefono-error" />
          <p class="campo__error" id="f-telefono-error"></p>
        </div>
        <div class="campo">
          <label class="campo__etiqueta" for="f-mensaje">Cuéntanos tu proyecto</label>
          <textarea id="f-mensaje" name="mensaje" required aria-describedby="f-mensaje-error" data-error-vacio="Cuéntanos brevemente qué necesitas."></textarea>
          <p class="campo__error" id="f-mensaje-error"></p>
        </div>
        <p class="legal-nota">Usaremos tus datos solo para responderte. Más información en el <a href={href('/aviso-legal-y-privacidad/')}>aviso legal y privacidad</a>.</p>
        <div><button class="boton boton--coral" type="submit">{t('es', 'enviar')}</button></div>
        <p class="estado" role="status" aria-live="polite" data-estado></p>
      </form>
    </div>
  </section>
</Base>
