# Dominio final o URL de staging (afecta a canonical, sitemap y JSON-LD)
SITE_URL=https://binome.xyz
# Solo si el staging está en subruta, p. ej. /binome-web/
BASE_PATH=/
# true en staging: añade noindex y bloquea rastreo en robots.txt
PUBLIC_NOINDEX=false
# ID del formulario de Formspree (https://formspree.io/f/XXXXXXXX)
PUBLIC_FORMSPREE_ID=
# Enlace de agenda (Cal.com, Calendly…) para "Agenda una reunión"
PUBLIC_BOOKING_URL=
